// Do not put the raw fanart.tv key here. Run Scripts/make-secrets.sh instead: it asks for
// the key (hidden input), then writes Config/Secrets.xcconfig (gitignored) containing the
// key XORed with a random salt, in this shape:
FANART_KEY_DATA = 0123456789abcdef
FANART_KEY_SALT = fedcba9876543210
